# Copy this file to .env.local and fill in all required values

# Database — required
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/base_app"

# Auth — required. Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# OAuth — optional; remove unused providers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public env (exposed to browser)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
